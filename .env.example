# Copie este arquivo para .env.local e preencha. O .env.local NUNCA vai para o Git
# (já está no .gitignore). Veja docs/SETUP.md para saber onde pegar cada valor.

# Supabase → Project Settings → API (são públicas: podem ir para o navegador)
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxx

# Segredos (NUNCA com prefixo NEXT_PUBLIC_, nunca no navegador).
# Descomente só quando o projeto precisar, e use apenas em código de servidor.
# SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxx
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxx

# Lembrete diário (Web Push). Gere com: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Segredo do envio diário (Vercel Cron). O SHA-256 dele vai em private.segredos no banco.
CRON_SECRET=
